# Backend
DB_URL=sqlite:////data/tickets.db
MODEL_NAME=mock         # mock | baseline | deberta
MODEL_PATH=./ticket-triage-be/models
MODEL_TASK=absa         # absa | document
ENABLE_ABTE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
HF_HUB_OFFLINE=1

# Hot reload trên Windows
WATCH_POLL=false
WATCHFILES_FORCE_POLLING=false

# Frontend
VITE_USE_MOCK=false
VITE_PROXY_TARGET=http://backend:8000
