DB_URL=sqlite:////data/tickets.db
MODEL_NAME=mock                    # mock | baseline | deberta
MODEL_PATH=./models                # Chỉ dùng nếu thư mục có config.json; bỏ qua tự động nếu trống
MODEL_ID=                          # Tùy chọn repo HuggingFace (vd: MoritzLaurer/deberta-v3-base-zeroshot-v1.1-all-33)
MODEL_TASK=absa
ENABLE_ABTE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
HF_HUB_OFFLINE=1                   # Đặt 0 nếu tải từ HuggingFace lần đầu; đặt 1 khi chạy offline từ ./models hoặc cache
WATCH_POLL=false
WATCHFILES_FORCE_POLLING=false
